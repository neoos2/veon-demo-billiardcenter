---
// Службова сторінка 404: повертає на головну.
import Base from "../layouts/Base.astro";
---
<Base lang="uk" title="Сторінку не знайдено | Більярд Центр" description="Такої сторінки немає. Поверніться на головну «Більярд Центр».">
  <section class="nf surface-cloth">
    <div class="container nf__in">
      <h1>Такої сторінки немає</h1>
      <p class="text-2">Можливо, адресу змінено. Усе про столи, ціни й контакти — на головній.</p>
      <p class="nf__actions">
        <a class="btn btn--primary" href="./">На головну</a>
        <a class="link link--brass" href="tel:+380673324028">067-332-40-28</a>
      </p>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 100svh; display: grid; align-items: center; padding-block: var(--s-8); }
  .nf__in { display: grid; gap: var(--s-4); justify-items: start; }
  .nf h1 { font-size: var(--fs-1); text-wrap: balance; }
  .nf__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4); }
  .nf__actions .link { display: inline-flex; align-items: center; min-height: var(--tap); }
</style>
